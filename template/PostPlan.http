### Template genérico — todos os campos do PlanComplete
POST {{host}}/billings/plans
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Plan Test",
  "slug": "plan-test",
  "description": "Plano de teste com todos os campos do PlanComplete preenchidos.",
  "price_in_cents": 399000,
  "currency": "BRL",
  "billing_interval": "BILLING_INTERVAL_MONTHLY",
  "billing_interval_count": 1,
  "trial_days": 7,
  "type": "PLAN_TYPE_PAID",
  "status": "PLAN_STATUS_ACTIVE",
  "is_public": true,
  "discount_percentage": 10,
  "callback_url": "https://api.audita.com/api/billings/webhooks/plans",
  "provider": [
    {
      "id": "mp_plan_0001",
      "provider": "PAYMENT_PROVIDER_MERCADO_PAGO"
    }
  ],
  "metadata": {
    "origin": "http-client",
    "environment": "dev"
  }
}

### Valores aceitos nos enums
#
# billing_interval: BILLING_INTERVAL_UNSPECIFIED | BILLING_INTERVAL_DAILY | BILLING_INTERVAL_WEEKLY
#                   BILLING_INTERVAL_MONTHLY | BILLING_INTERVAL_QUARTERLY
#                   BILLING_INTERVAL_SEMIANNUALLY | BILLING_INTERVAL_YEARLY
#
# type:             PLAN_TYPE_UNSPECIFIED | PLAN_TYPE_FREE | PLAN_TYPE_PAID | PLAN_TYPE_ENTERPRISE
#
# status:           PLAN_STATUS_UNSPECIFIED | PLAN_STATUS_DRAFT | PLAN_STATUS_ACTIVE
#                   PLAN_STATUS_INACTIVE | PLAN_STATUS_ARCHIVED
#
# provider.provider: PAYMENT_PROVIDER_UNSPECIFIED | PAYMENT_PROVIDER_MERCADO_PAGO
#                    PAYMENT_PROVIDER_STRIPE | PAYMENT_PROVIDER_ASAAS | PAYMENT_PROVIDER_PAGARME
#
# Campos gerenciados pelo servidor (id, created_at, updated_at) foram omitidos do corpo.
