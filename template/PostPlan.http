### Catálogo real (espelha audita-web/src/features/billing/plans.ts)
#
# `PlanComplete.metadata` é `map<string, string>`: só aceita valores string,
# nada aninhado. Os diferenciais entram como chaves numeradas, começando em 1
# e sem buracos, para o front iterar até a chave não existir mais:
#
#   benefit_N           -> o que o plano TEM
#   non_have_benefit_N  -> o que o plano NÃO tem (renderiza riscado/apagado)
#   highlight_benefit_N -> opcional, "true" marca a linha que vende o tier
#                          (N referencia benefit_N ou non_have_benefit_N)
#
# Para adicionar um benefício depois: basta somar +1 no último N. Nada no
# front precisa mudar.
#
# `PlanComplete` tem um único price_in_cents + billing_interval, então cada
# ciclo do front (monthly/yearly) é um plano próprio. `metadata.family`
# agrupa os dois ciclos do mesmo tier e `metadata.cycle` diz qual é qual.
#
# `metadata.payer_role` é o tier que o pagamento aprovado concede no client
# (enum PayerRole: Free | Basic | Pro | Enterprise). Sem ele, o client cai no
# fallback pelo `type` do plano — PLAN_TYPE_PAID vira Basic.
#
# O campo `provider` foi omitido de propósito: o id do preapproval_plan do
# Mercado Pago só existe depois de criado lá. Preencha com o id real antes
# de cobrar — um id errado cobra o valor errado.

### 1. Essencial — mensal (R$ 39,90/mês)
POST {{host}}/billings/plans
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Essencial",
  "slug": "essencial-mensal",
  "description": "Encontre e acompanhe licitações sem planilha.",
  "price_in_cents": 3990,
  "currency": "BRL",
  "billing_interval": 3,
  "billing_interval_count": 1,
  "trial_days": 7,
  "type": 2,
  "is_public": true,
  "discount_percentage": 0,
  "callback_url": "https://api.audita.com/api/billings/webhooks/plans",
  "metadata": {
    "family": "essencial",
    "cycle": "monthly",
    "payer_role": "Basic",
    "tier_order": "1",
    "recommended": "false",
    "upsell": "Sem a análise por IA, cada edital leva de 20 a 40 minutos de leitura manual.",
    "benefit_1": "Busca completa no PNCP, com filtros por objeto, órgão e valor",
    "benefit_2": "Gestão das suas licitações com prazos e ciclo de vida",
    "benefit_3": "Favoritos e alertas de encerramento",
    "benefit_4": "Boletim por e-mail",
    "benefit_5": "1 usuário",
    "non_have_benefit_1": "Análise de edital por IA",
    "non_have_benefit_2": "Automações e monitoramento contínuo",
    "non_have_benefit_3": "Logo, cores e domínio da sua empresa",
    "non_have_benefit_4": "3 assentos extras para a equipe, com cotas compartilhadas",
    "highlight_non_have_benefit_1": "true",
    "highlight_non_have_benefit_2": "true"
  }
}

